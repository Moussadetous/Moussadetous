<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MousseOS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mousse_primary</item>
        <item name="colorPrimaryContainer">@color/mousse_primary</item>
        <item name="colorOnPrimary">@color/mousse_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/mousse_on_primary</item>
        <item name="colorSecondary">@color/mousse_secondary</item>
        <item name="colorSecondaryContainer">@color/mousse_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorSurface">@color/mousse_background</item>
        <item name="colorOnSurface">@color/mousse_text_primary</item>
        <item name="colorSurfaceVariant">@color/mousse_card_bg</item>
        <item name="colorOnSurfaceVariant">@color/mousse_text_secondary</item>
        <item name="colorBackground">@color/mousse_background</item>
        <item name="colorOnBackground">@color/mousse_text_primary</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:statusBarColor">@color/mousse_primary_dark</item>
        <item name="android:navigationBarColor">@color/mousse_card_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MousseOS.AppBarOverlay" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="Theme.MousseOS.PopupOverlay" parent="ThemeOverlay.Material3.Light">
    </style>

    <!-- Custom styles -->
    <style name="MousseOS.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/mousse_primary</item>
        <item name="android:elevation">4dp</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="MousseOS.Card" parent="Widget.Material3.Card">
        <item name="android:background">@color/mousse_card_bg</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <style name="MousseOS.Button" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/mousse_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="MousseOS.Button.Outlined" parent="Widget.Material3.OutlinedButton">
        <item name="android:textColor">@color/mousse_primary</item>
        <item name="strokeColor">@color/mousse_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="MousseOS.TextView" parent="Widget.Material3.TextView">
        <item name="android:textColor">@color/mousse_text_primary</item>
    </style>

    <style name="MousseOS.TextView.Secondary" parent="Widget.Material3.TextView">
        <item name="android:textColor">@color/mousse_text_secondary</item>
    </style>

    <style name="MousseOS.EditText" parent="Widget.Material3.TextInputEditText">
        <item name="android:textColor">@color/mousse_text_primary</item>
        <item name="android:hintTextColor">@color/mousse_text_secondary</item>
    </style>

    <style name="MousseOS.FloatingActionButton" parent="Widget.Material3.FloatingActionButton">
        <item name="android:backgroundTint">@color/mousse_primary</item>
        <item name="android:tint">@color/white</item>
    </style>
</resources>
