<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/recyclerview_item_height"
    android:layout_margin="@dimen/card_margin"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/mousse_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/default_padding"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="@dimen/app_icon_size"
            android:layout_height="@dimen/app_icon_size"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_web_app"
            android:contentDescription="App Icon"
            android:layout_marginEnd="@dimen/default_padding" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/appName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App Name"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/mousse_text_primary"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/appDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/mousse_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/tiny_margin" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/appFavorite"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_favorite_outline"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/tiny_margin" />

            <TextView
                android:id="@+id/appSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B"
                android:textSize="@dimen/text_size_tiny"
                android:textColor="@color/mousse_text_secondary" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
