<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mousse_background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.MousseOS.AppBarOverlay">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/mousse_primary"
            android:elevation="@dimen/toolbar_elevation"
            app:title="@string/main_title"
            app:titleTextColor="@color/white"
            app:subtitle="@string/main_subtitle"
            app:subtitleTextColor="@color/white">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="8dp"/>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_app" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabInstall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:backgroundTint="@color/mousse_primary"
        android:src="@drawable/ic_add"
        android:tint="@color/white"
        app:tint="@color/white"
        tools:ignore="MissingPrefix" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/no_apps_installed"
        android:textSize="@dimen/text_size_medium"
        android:textColor="@color/mousse_text_secondary"
        android:visibility="gone"
        android:padding="@dimen/default_padding" />

    <TextView
        android:id="@+id/tvEmptyDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_below="@id/tvEmpty"
        android:text="@string/no_apps_description"
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/mousse_text_secondary"
        android:visibility="gone"
        android:padding="@dimen/default_padding" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
